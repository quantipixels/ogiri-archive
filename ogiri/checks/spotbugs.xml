<FindBugsFilter>
<!-- These classes retain injected, thread-safe Spring infrastructure; copying it would break transaction participation. -->
<Match><Class name="~com\.quantipixels\.ogiri\.(internal\.AuthTransactions|internal\.SessionRepository|JdbcSessions|account\.internal\.SignInService|account\.internal\.RegistrationService|account\.internal\.PasswordService|account\.internal\.ActivationService|internal\.JavaMailOgiriMailer|internal\.MailDispatcher|security\.OgiriRuntime|security\.internal\.OgiriTokenAuthenticationProvider)"/><Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/></Match>
<!-- SQL text consists only of private fixed dialect/owner fragments. All values are bound parameters. -->
<Match><Class name="~com\.quantipixels\.ogiri\.(internal\.AuthTransactions|internal\.SessionRepository)"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
<!-- Adapter validates table/column identifiers against a literal identifier grammar; predicates are private fixed strings or the three allowlisted token columns. Values are bound. -->
<Match><Class name="com.quantipixels.ogiri.account.internal.JdbcDeviseAccountStore"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
<!-- The response is application/json, produced by Jackson from fixed DTA envelopes; no HTML template or raw input is written. -->
<Match><Class name="com.quantipixels.ogiri.security.internal.DtaErrors"/><Method name="write"/><Bug pattern="XSS_SERVLET"/></Match>
<!-- The string is a protocol query parameter name, never a password value. -->
<Match><Class name="com.quantipixels.ogiri.account.internal.PasswordService"/><Method name="follow"/><Bug pattern="HARD_CODE_PASSWORD"/></Match>
<!-- Endpoint retains the shared, thread-safe workflow service injected by Spring. -->
<Match><Class name="com.quantipixels.ogiri.web.internal.OgiriEndpoints"/><Method name="&lt;init&gt;"/><Bug pattern="EI_EXPOSE_REP2"/></Match>
<!-- ClientRotation retains the shared transaction coordinator so rotations join the caller's row locks. -->
<Match><Class name="com.quantipixels.ogiri.internal.ClientRotation"/><Method name="&lt;init&gt;"/><Bug pattern="EI_EXPOSE_REP2"/></Match>
<!-- Filter and SecurityContextHolderFilter deliberately share Spring's thread-safe request repository and its scoped key. -->
<Match><Class name="com.quantipixels.ogiri.security.internal.OgiriAuthenticationFilter"/><Method name="&lt;init&gt;" params="com.quantipixels.ogiri.security.OgiriRealms,org.springframework.security.web.context.RequestAttributeSecurityContextRepository"/><Bug pattern="EI_EXPOSE_REP2"/></Match>
<!-- Runtime is immutable configuration with shared injected services; copying it would create a different auth instance. -->
<Match><Class name="com.quantipixels.ogiri.security.OgiriRealms"/><Method name="&lt;init&gt;"/><Bug pattern="EI_EXPOSE_REP2"/></Match>
<!-- The configured default runtime must retain its identity and shared transaction owner. -->
<Match><Class name="com.quantipixels.ogiri.security.OgiriRealms"/><Method name="defaultRealm"/><Bug pattern="EI_EXPOSE_REP"/></Match>
<!-- Resolving a mount returns the configured runtime instance rather than a copy with a different request namespace. -->
<Match><Class name="com.quantipixels.ogiri.security.OgiriRealms"/><Method name="resolve"/><Bug pattern="EI_EXPOSE_REP"/></Match>
</FindBugsFilter>